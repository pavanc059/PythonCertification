SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql://stockiq:stockiq@localhost:5432/stockiq
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173

# Webull credentials and configuration
WEBULL_EMAIL=your-webull-email@example.com       # Webull account email
WEBULL_PASSWORD=your-webull-password             # Webull account password
WEBULL_DEVICE_ID=your-registered-device-uuid     # Registered device UUID
WEBULL_TRADING_PIN=                              # NEVER used for read-only calls — stored only
WEBULL_MFA_CODE=                                 # Optional TOTP/MFA code for login
WEBULL_SESSION_REFRESH_INTERVAL=3300             # Seconds between token refreshes (default 3300 = 55 min)
MARKET_DATA_SOURCE=webull                        # Active market data provider: webull | yfinance | stub
