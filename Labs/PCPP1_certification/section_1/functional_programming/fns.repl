>>> # Functions as arguments in stdlib
>>> animals = ["ferret", "vole", "dog", "gecko"]
>>> sorted(animals)
['dog', 'ferret', 'gecko', 'vole']
>>> for animal in animals:
...     print(animal, len(animal))
...
ferret 6
vole 4
dog 3
gecko 5
>>> sorted(animals, key=len)
