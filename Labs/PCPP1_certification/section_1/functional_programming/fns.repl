>>> # Function calling vs references
>>> def say_hello():
...     print("Hello!")
...
>>> say_hello()
Hello!
>>> say_hello
<function say_hello at 0x1049b57a0>
>>> also_hello = say_hello
>>> also_hello()
Hello!
>>> print
<built-in function print>
>>> # Function references as arguments
>>> print("You came here for an argument?")
You came here for an argument?
>>> print("I would like to have an argument, please", 1972)
I would like to have an argument, please 1972
>>> print("Is this a five minute argument?", say_hello)
Is this a five minute argument? <function say_hello at 0x1049b57a0>
>>> print(say_hello, print)
